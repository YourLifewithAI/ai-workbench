{
  "schemaVersion": 1,
  "network": {
    "mode": "allowlist",
    "allowLocalAddresses": false,
    "allow": [],
    "approvalExempt": []
  },
  "budgets": {
    "maxModelCalls": 60,
    "maxToolCalls": 120,
    "maxCostUsd": 2.0,
    "maxWallClockMs": 1800000,
    "toolCallTimeoutMs": 60000,
    "dailySpendCapUsd": 20.0,
    "monthlySpendCapUsd": 100.0
  },
  "execution": {
    "maxParallelSteps": 4,
    "maxConcurrentRuns": 2,
    "escalation": "sensitive-only"
  },
  "retention": {
    "scratchDays": 7,
    "backups": 5
  },
  "context": {
    "keepRecentToolResults": 5,
    "maxToolResultChars": 8000,
    "memoryItems": 8,
    "knowledgeChunks": 6
  },
  "search": {
    "provider": "mock"
  },
  "tools": {
    "http": {
      "maxResponseBytes": 2097152,
      "timeoutMs": 20000
    }
  },
  "mcp": {
    "servers": []
  },
  "plugins": {
    "trusted": []
  },
  "push": {
    "enabled": true,
    "events": [
      "approval-requested",
      "review-blocking",
      "run-failed",
      "scheduled-completed"
    ]
  },
  "discovery": {
    "providers": {
      "openai": {
        "adapter": "openai-compatible",
        "baseUrl": "https://api.openai.com/v1"
      },
      "qwen": {
        "adapter": "openai-compatible",
        "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
      },
      "kimi": {
        "adapter": "openai-compatible",
        "baseUrl": "https://api.moonshot.ai/v1"
      }
    }
  },
  "models": {
    "roles": {
      "capable": [
        "anthropic/claude-sonnet-5",
        "google/gemini-3.8-flash",
        "anthropic/claude-opus-5",
        "google/gemini-2.5-pro",
        "ollama/qwen3:14b"
      ],
      "fast": [
        "google/gemini-3.6-flash",
        "anthropic/claude-haiku-4-5",
        "google/gemini-2.5-flash",
        "ollama/qwen3:14b"
      ],
      "cheap": [
        "google/gemini-3.6-flash",
        "anthropic/claude-haiku-4-5",
        "ollama/qwen3:14b"
      ]
    }
  },
  "grants": {},
  "remembered": []
}
