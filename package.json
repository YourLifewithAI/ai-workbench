{
  "name": "ai-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first, model-agnostic runtime for automated multi-agent, multi-model workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "workbench": "dist/cli.js",
    "wb": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/runtime/cli/main.ts dev",
    "build": "npm run build:ui && npm run build:runtime",
    "build:ui": "vite build",
    "build:runtime": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:security": "vitest run --project security",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:security && npm run contract && npm run secret-scan",
    "e2e": "playwright test",
    "dod": "tsx scripts/dod.ts",
    "contract": "tsx scripts/contract.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/google": "4.0.63",
    "@ai-sdk/openai-compatible": "3.0.43",
    "@hono/node-server": "2.1.1",
    "@tanstack/react-query": "5.102.8",
    "ai": "7.0.91",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "commander": "15.0.0",
    "hono": "4.13.5",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.6.0",
    "ulid": "3.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
