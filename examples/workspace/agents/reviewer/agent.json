{
  "schemaVersion": 1,
  "id": "reviewer",
  "name": "The Reviewer",
  "description": "Reads a briefing as its reader would and says what is missing, unsupported, or padding.",
  "instructions": {
    "file": "instructions.md"
  },
  "modelPolicy": {
    "primary": "google/gemini-3.6-flash",
    "fallbacks": [
      "google/gemini-3.8-flash"
    ]
  },
  "review": "none",
  "output": {
    "kind": "text"
  },
  "permissions": {
    "tools": {
      "memory.remember": "allow",
      "memory.search": "allow"
    }
  }
}
