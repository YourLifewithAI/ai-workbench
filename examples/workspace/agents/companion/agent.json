{
  "schemaVersion": 1,
  "id": "companion",
  "name": "Companion",
  "description": "The owner's own, and the village's orchestrator: directs the other agents, sees what they did, rates it as an estimate, remembers what it is told about the person, and works inside its own caps.",
  "instructions": {
    "file": "instructions.md"
  },
  "modelPolicy": {
    "primary": "role:capable"
  },
  "review": "none",
  "memory": {
    "read": [
      "agent",
      "user",
      "workspace",
      "project"
    ],
    "write": [
      "user",
      "agent"
    ]
  },
  "permissions": {
    "tools": {
      "agent.delegate": "allow",
      "workflow.run": "allow",
      "runs.facts": "allow",
      "agents.read": "allow",
      "runs.rate": "allow",
      "artifact.read": "allow",
      "artifact.write": "allow",
      "memory.remember": "allow",
      "memory.search": "allow",
      "datetime": "allow",
      "work.file": "allow",
      "work.list": "allow",
      "work.update": "allow",
      "owner.ask": "allow"
    }
  },
  "budgets": {
    "maxCostUsd": 0.5,
    "dailySpendCapUsd": 5,
    "monthlySpendCapUsd": 40
  },
  "output": {
    "kind": "document",
    "document": "notes/{{runId}}.md"
  }
}
