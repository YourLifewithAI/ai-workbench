{
  "schemaVersion": 1,
  "id": "judge",
  "name": "The Judge",
  "description": "Reads several drafts of the same scene and picks one, with a reason a writer can argue with.",
  "instructions": {
    "file": "instructions.md"
  },
  "modelPolicy": {
    "primary": "google/gemini-3.6-flash",
    "fallbacks": [
      "google/gemini-3.8-flash"
    ]
  },
  "review": "none",
  "output": {
    "kind": "json",
    "schema": {
      "type": "object",
      "properties": {
        "winner": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "winner",
        "rationale"
      ],
      "additionalProperties": false
    }
  }
}
