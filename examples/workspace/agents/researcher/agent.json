{
  "schemaVersion": 1,
  "id": "researcher",
  "name": "The Researcher",
  "description": "Answers one question from the web, with the sources it actually read.",
  "instructions": {
    "file": "instructions.md"
  },
  "modelPolicy": {
    "primary": "google/gemini-3.6-flash",
    "fallbacks": [
      "google/gemini-3.8-flash"
    ]
  },
  "permissions": {
    "tools": {
      "web.search": "allow",
      "http.fetch": "allow"
    },
    "net": {
      "mode": "allowlist",
      "allow": []
    }
  },
  "review": "none",
  "output": {
    "kind": "text"
  }
}
