{
  "schemaVersion": 1,
  "id": "builder",
  "name": "The Builder",
  "description": "Turns a plan for a small site into the files that are the site.",
  "instructions": {
    "file": "instructions.md"
  },
  "modelPolicy": {
    "primary": "role:capable"
  },
  "permissions": {
    "tools": {
      "artifact.write": "allow",
      "artifact.read": "allow",
      "code.execute": "allow"
    }
  },
  "review": "none",
  "output": {
    "kind": "text"
  }
}
